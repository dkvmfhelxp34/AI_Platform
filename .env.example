# Buoy_platform 환경변수 예시 — 실제 값을 채워 `.env` 로 복사해 사용
# 실제 `.env` 는 커밋 금지(.gitignore 처리됨). 셸에서: set -a; source ./.env; set +a

# 서빙 포트
PORT=8506

# LLM 백엔드 — 이 플랫폼은 claude -p CLI 전용
LLM_BACKEND=claude

# 기상청 API Hub (apihub.kma.go.kr) authKey — 발급: https://apihub.kma.go.kr
KMA_APIHUB_KEY=YOUR_KMA_APIHUB_AUTHKEY

# 국립해양조사원 공공데이터포털 serviceKey(인코딩형) — 발급: https://www.data.go.kr
KHOA_DATA_KEY=YOUR_DATA_GO_KR_SERVICEKEY_ENCODED
